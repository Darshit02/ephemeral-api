# Ephemeral Web Client - Environment Variables Example
# Duplicate this file to .env.local for local development.

# Core API Service (Authentication, Subscriptions, Users, APIs)
NEXT_PUBLIC_CORE_API=http://localhost:8081

# Admin API Service (Publisher Management, Revenue, Auditing)
NEXT_PUBLIC_ADMIN_API=http://localhost:8082

# API Gateway Ingress (Proxied live API traffic)
NEXT_PUBLIC_GATEWAY=http://localhost:8080

# Public application base URL (used for canonical links, sitemaps, robots.txt)
NEXT_PUBLIC_APP_URL=http://localhost:3000
